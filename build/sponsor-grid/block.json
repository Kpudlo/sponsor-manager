{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sponsor-manager/grid",
  "version": "1.5.0",
  "title": "Sponsors",
  "category": "widgets",
  "icon": "megaphone",
  "description": "Display sponsor ads horizontally or vertically. Extra ads rotate in every two minutes.",
  "keywords": [
    "sponsor",
    "ad",
    "grid",
    "banner",
    "sidebar"
  ],
  "attributes": {
    "placement": {
      "type": "string",
      "default": ""
    },
    "orientation": {
      "type": "string",
      "enum": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    },
    "maxItems": {
      "type": "number",
      "default": 0
    },
    "columns": {
      "type": "number",
      "default": 4
    },
    "rows": {
      "type": "number",
      "default": 1
    },
    "useGlobalStyles": {
      "type": "boolean",
      "default": true
    },
    "borderRadius": {
      "type": "number",
      "default": 6
    },
    "borderWidth": {
      "type": "number",
      "default": 2
    },
    "showShadow": {
      "type": "boolean",
      "default": true
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "shadowColor": {
      "type": "string",
      "default": ""
    },
    "shadowOffsetX": {
      "type": "number",
      "default": 2
    },
    "shadowOffsetY": {
      "type": "number",
      "default": 2
    },
    "shadowBlur": {
      "type": "number",
      "default": 0
    },
    "shadowSpread": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "textdomain": "sponsor-manager",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}