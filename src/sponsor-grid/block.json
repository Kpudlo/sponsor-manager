{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sponsor-manager/grid",
	"version": "1.0.0",
	"title": "Sponsor Grid",
	"category": "widgets",
	"icon": "grid-view",
	"description": "Display up to four sponsor ads in a responsive grid with priority-weighted rotation.",
	"keywords": [ "sponsor", "ad", "grid", "banner" ],
	"attributes": {
		"placement": {
			"type": "string",
			"default": ""
		},
		"useGlobalStyles": {
			"type": "boolean",
			"default": true
		},
		"borderRadius": {
			"type": "number",
			"default": 6
		},
		"borderWidth": {
			"type": "number",
			"default": 2
		},
		"showShadow": {
			"type": "boolean",
			"default": true
		},
		"borderColor": {
			"type": "string",
			"default": ""
		},
		"shadowColor": {
			"type": "string",
			"default": ""
		},
		"shadowOffsetX": {
			"type": "number",
			"default": 2
		},
		"shadowOffsetY": {
			"type": "number",
			"default": 2
		},
		"shadowBlur": {
			"type": "number",
			"default": 0
		},
		"shadowSpread": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "sponsor-manager",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
