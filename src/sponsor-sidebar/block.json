{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sponsor-manager/sidebar",
	"version": "1.5.0",
	"title": "Sponsor Sidebar (deprecated)",
	"category": "widgets",
	"icon": "align-wide",
	"description": "Deprecated. Use the Sponsors block with a vertical layout instead.",
	"keywords": [ "sponsor", "ad", "sidebar", "banner" ],
	"attributes": {
		"placement": {
			"type": "string",
			"default": ""
		},
		"useGlobalStyles": {
			"type": "boolean",
			"default": true
		},
		"borderRadius": {
			"type": "number",
			"default": 6
		},
		"borderWidth": {
			"type": "number",
			"default": 2
		},
		"showShadow": {
			"type": "boolean",
			"default": true
		},
		"borderColor": {
			"type": "string",
			"default": ""
		},
		"shadowColor": {
			"type": "string",
			"default": ""
		},
		"shadowOffsetX": {
			"type": "number",
			"default": 2
		},
		"shadowOffsetY": {
			"type": "number",
			"default": 2
		},
		"shadowBlur": {
			"type": "number",
			"default": 0
		},
		"shadowSpread": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "sponsor-manager",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
